{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/carsimax/brunnr-code/contracts/review-integration/v1/schemas/operation.schema.json",
  "title": "Brunnr-Code negotiated review operation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract", "operation", "result"],
  "properties": {
    "schema": {"const": "brunnr-code.review-integration.operation/v1"},
    "contract": {"const": "brunnr-code.review-integration/v1"},
    "operation": {"const": "review.validate"},
    "result": {"$ref": "#/$defs/validate"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "validate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "result", "allowed", "action", "reason", "context"],
      "properties": {
        "schema": {"const": "brunnr-code.review-gate-result/v1"},
        "result": {"enum": ["allow", "scope-changed", "invalidated", "escalated"]},
        "allowed": {"type": "boolean"},
        "action": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "context": {"type": "object"},
        "delivery": {"enum": ["disabled/unmanaged", "unmanaged"]}
      }
    }
  }
}
