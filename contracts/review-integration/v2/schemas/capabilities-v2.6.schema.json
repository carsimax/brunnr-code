{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/carsimax/brunnr-code/contracts/review-integration/v2/schemas/capabilities-v2.6.schema.json",
  "title": "Brunnr-Code review integration capabilities protocol 2.6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract",
    "protocol",
    "package",
    "build",
    "executable",
    "operations",
    "gates",
    "projections",
    "schemas",
    "features",
    "compatibility"
  ],
  "properties": {
    "schema": {
      "const": "brunnr-code.review-integration.capabilities/v2.6"
    },
    "contract": {
      "$ref": "capabilities-v2.3.schema.json#/properties/contract"
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "major",
        "minor"
      ],
      "properties": {
        "major": {
          "const": 2
        },
        "minor": {
          "const": 6
        }
      }
    },
    "package": {
      "$ref": "capabilities-v2.3.schema.json#/properties/package"
    },
    "build": {
      "$ref": "capabilities-v2.3.schema.json#/properties/build"
    },
    "executable": {
      "$ref": "capabilities-v2.3.schema.json#/properties/executable"
    },
    "operations": {
      "$ref": "capabilities-v2.3.schema.json#/properties/operations"
    },
    "gates": {
      "$ref": "capabilities-v2.3.schema.json#/properties/gates"
    },
    "projections": {
      "$ref": "capabilities-v2.3.schema.json#/properties/projections"
    },
    "schemas": {
      "type": "array",
      "minItems": 23,
      "maxItems": 23,
      "uniqueItems": true,
      "items": {
        "enum": [
          "brunnr-code.review-admitted-result/v2",
          "brunnr-code.review-artifact-subject/v2",
          "brunnr-code.review-authority-repair-assessment/v1",
          "brunnr-code.review-authority-status/v1",
          "brunnr-code.review-gate-request/v1",
          "brunnr-code.review-integration.capabilities/v2.6",
          "brunnr-code.review-integration.consent/v3",
          "brunnr-code.review-integration.failure/v2",
          "brunnr-code.review-integration.operation/v2",
          "brunnr-code.review-integration.projection/v1",
          "brunnr-code.review-integration.repair/v2",
          "brunnr-code.review-integration.start/v4",
          "brunnr-code.review-integration.status/v5",
          "brunnr-code.review-integration.status/v6",
          "brunnr-code.review-integration.status/v7",
          "brunnr-code.review-integration.status/v8",
          "brunnr-code.review-intended-untracked-selection/v1",
          "brunnr-code.review-receipt/v1",
          "brunnr-code.review-result-artifact/v2",
          "brunnr-code.review-targeted-validation-request/v1",
          "https://github.com/carsimax/brunnr-code/schema/review/refuter/v1",
          "https://github.com/carsimax/brunnr-code/schema/review/reviewer/v1",
          "https://github.com/carsimax/brunnr-code/schema/review/validator/v1"
        ]
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mandatory",
        "optional"
      ],
      "properties": {
        "mandatory": {
          "$ref": "capabilities-v2.3.schema.json#/properties/features/properties/mandatory"
        },
        "optional": {
          "type": "array",
          "minItems": 15,
          "maxItems": 19,
          "items": {
            "$ref": "capabilities-v2.3.schema.json#/$defs/feature"
          }
        }
      }
    },
    "bootstrap": {
      "$ref": "capabilities-v2.3.schema.json#/properties/bootstrap"
    },
    "compatibility": {
      "$ref": "capabilities-v2.3.schema.json#/properties/compatibility"
    }
  }
}
